/target

# The build directory CI's commands make at the root (`-B build`), and those an IDE can make in
# gui/qt/: kept out of git and out of dev/check-gui.sh's list. `build` and its symlink alike (no
# trailing slash); build-* and cmake-build-*, the names Qt Creator and CLion give one, as
# directories only, so that a source file whose name starts the same is not ignored with them.
/build
/gui/qt/build
/gui/qt/build-*/
/gui/qt/cmake-build-*/

# Specs, plans, and review findings. Kept on disk as a working record, but not tracked, so a routine
# `git add -A` cannot put them in the history.
/docs/
